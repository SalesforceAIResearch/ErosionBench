# ErosionBench — environment template
# Copy to `.env` and fill in your own keys. `.env` is gitignored; never commit real keys.
#
# The runtime talks to every model provider through an OpenAI-compatible client.
# The provider is inferred from the model name:
#   gpt-* / o*  -> OpenAI    (primary path)
#   claude-*    -> Anthropic (secondary endpoint, see below)
#   gemini-*    -> Google    (secondary endpoint, see below)

# --- OpenAI (primary path) ---------------------------------------------------
# A real OpenAI key works out of the box: leave OPENAI_BASE_URL unset and it
# defaults to the public API (https://api.openai.com/v1). This alone runs the
# datagen / mesh / judge roles (all gpt-* by default).
OPENAI_API_KEY=sk-your-openai-key-here

# Optional. Only set this if you route OpenAI calls through your own
# OpenAI-compatible gateway/proxy instead of the public API.
# OPENAI_BASE_URL=https://your-openai-compatible-gateway.example/v1/

# --- Model selection ---------------------------------------------------------
# Override the model used per role if desired.
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_JUDGE_MODEL=gpt-4o

# --- Claude / Gemini (native keys — simplest path) ---------------------------
# Drop in your own Anthropic / Google keys and claude-* / gemini-* models run
# directly against each provider's OpenAI-compatible endpoint. No gateway needed.
# NOTE: those provider endpoints are OpenAI-compat shims (beta on some providers),
# so behavior may differ slightly from a dedicated gateway; for exact paper parity
# use a gateway (below).
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GEMINI_API_KEY=your-gemini-key-here

# --- Claude / Gemini (alternative: shared gateway) ---------------------------
# Instead of native keys, route claude-* / gemini-* through one OpenAI-compatible
# gateway/proxy (Authorization: Bearer auth). One endpoint + one key serves both.
# This path takes precedence over the native keys above when set.
# LLM_GATEWAY_BASE_URL=https://your-openai-compatible-gateway.example/v1/
# LLM_GATEWAY_API_KEY=your_gateway_bearer_token_here
#
# If that gateway's TLS chain is signed by a private CA, point this at the CA's
# PEM file; it is combined with certifi's public bundle for the gateway client only.
# EROSIONBENCH_EXTRA_CA_BUNDLE=/path/to/private-ca-bundle.pem
#
# Finer control: explicit per-provider base URLs (override the native/derived ones).
# ANTHROPIC_BASE_URL=https://your-openai-compatible-gateway.example/anthropic/v1/
# GEMINI_BASE_URL=https://your-openai-compatible-gateway.example/google/v1/
#
# Self-hosted open-weight models (e.g. a vLLM endpoint) served over the OpenAI
# schema: list their served-model-names so they ride the gateway.
# EROSIONBENCH_OPEN_MODELS=llama-3.3-70b,gemma-2-27b

# --- Hugging Face Hub (only for scripts/download_data.py) --------------------
# The full dataset + PDF corpus are fetched from the Hub. huggingface_hub reads
# HF_TOKEN automatically; set it only if the data repo is private/gated.
# A runnable slice ships in data/sample/, so no token is needed for a first look.
# HF_TOKEN=hf_your_read_token_here
# EROSIONBENCH_HF_REPO=Salesforce/ErosionBench

# --- Optional tuning ---------------------------------------------------------
# EROSIONBENCH_LLM_MAX_ATTEMPTS=3
# EROSIONBENCH_REASONING_HEADROOM=4000
